<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    logicalFilePath="db/changelog/platform-registry.xml"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
    Root changelog for the platform control-plane database (see TenantRegistry) - a small,
    non-tenant database, separate from every tenant's own database, holding the authoritative
    tenant -> database mapping. Deliberately its own root changelog: it is applied once, to the
    platform database's own public schema, never into a tenant database (whose identity schema is
    forwardmeasure-jpa-identity.xml).
    -->
    <changeSet id="platform-registry-001-tenant-registry" author="forwardmeasure">
        <comment>
            Replaces the previous "list of tenants" mechanism (scanning information_schema.schemata
            for t_% names) with a real, authoritative registry - see TenantRegistry's own javadoc.
        </comment>
        <createTable tableName="tenant_registry">
            <column name="tenant_id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tenant_did" type="VARCHAR(2048)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_tenant_registry_tenant_did"/>
            </column>
            <column name="alias" type="VARCHAR(255)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_tenant_registry_alias"/>
            </column>
            <column name="database_name" type="VARCHAR(63)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_tenant_registry_database_name"/>
            </column>
            <column name="status" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="cell" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="platform-registry-002-lifecycle-admission" author="forwardmeasure">
        <createTable tableName="lifecycle_admission_instance">
            <column name="instance_id" type="UUID"><constraints primaryKey="true" nullable="false" /></column>
            <column name="connection_budget" type="INTEGER"><constraints nullable="false" /></column>
        </createTable>
        <createTable tableName="lifecycle_admission_lease">
            <column name="instance_id" type="UUID"><constraints nullable="false" foreignKeyName="fk_admission_lease_instance" references="lifecycle_admission_instance(instance_id)" /></column>
            <column name="slot" type="INTEGER"><constraints nullable="false" /></column>
            <column name="holder_token" type="UUID" />
            <column name="tenant_id" type="UUID" />
            <column name="operation_id" type="UUID" />
            <column name="state" type="VARCHAR(20)" defaultValue="free"><constraints nullable="false" /></column>
            <column name="claim_deadline" type="TIMESTAMP WITH TIME ZONE" />
            <column name="expires_at" type="TIMESTAMP WITH TIME ZONE" />
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP"><constraints nullable="false" /></column>
        </createTable>
        <addPrimaryKey tableName="lifecycle_admission_lease" columnNames="instance_id,slot" constraintName="pk_lifecycle_admission_lease" />
        <sql>ALTER TABLE lifecycle_admission_instance ADD CONSTRAINT ck_admission_connection_budget CHECK (connection_budget > 0)</sql>
        <sql>ALTER TABLE lifecycle_admission_lease ADD CONSTRAINT ck_admission_lease_state CHECK ((state = 'free' AND holder_token IS NULL AND claim_deadline IS NULL AND expires_at IS NULL) OR (state = 'claimed' AND holder_token IS NOT NULL AND tenant_id IS NOT NULL AND operation_id IS NOT NULL AND claim_deadline IS NOT NULL AND expires_at IS NULL) OR (state = 'registered' AND holder_token IS NOT NULL AND tenant_id IS NOT NULL AND operation_id IS NOT NULL AND claim_deadline IS NOT NULL AND expires_at IS NOT NULL))</sql>
    </changeSet>
</databaseChangeLog>
