<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    logicalFilePath="db/changelog/forwardmeasure-jpa-locking.xml"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet
        id="forwardmeasure-jpa-locking-001-system-lock"
        author="forwardmeasure">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="system_lock" />
            </not>
        </preConditions>
        <comment>
            Create the tenant-local named mutex table. Applications own the
            separate changesets that seed their lock names.
        </comment>
        <createTable tableName="system_lock">
            <column name="lock_name" type="VARCHAR(256)">
                <constraints
                    primaryKey="true"
                    primaryKeyName="pk_system_lock"
                    nullable="false" />
            </column>
            <column name="description" type="VARCHAR(512)" />
            <column name="version" type="INTEGER" defaultValueNumeric="0">
                <constraints nullable="false" />
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>
